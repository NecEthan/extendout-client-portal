DATABASE_URL=postgresql://portal:portal@localhost:5544/portal

# Object storage. These values match the SeaweedFS container in docker-compose.dev.yml.
# In production, point them at Backblaze B2 (see README "Document storage").
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portal-documents
S3_ACCESS_KEY_ID=portal-dev
S3_SECRET_ACCESS_KEY=portal-dev-secret
